from collections.abc import Iterable, Mapping, Sequence

from matplotlib.artist import Artist
from matplotlib.patches import Polygon

type StyleValue = str | float | bool | tuple[float, float] | Mapping[str, str | float] | None

class Axes:
    def set_axis_off(self) -> None: ...
    def set(self, **kwargs: StyleValue) -> list[Artist]: ...
    def set_title(self, label: str, **kwargs: StyleValue) -> Artist: ...
    def grid(self, *, visible: bool, **kwargs: StyleValue) -> None: ...
    def axhline(self, y: float, **kwargs: StyleValue) -> Artist: ...
    def axvline(self, x: float, **kwargs: StyleValue) -> Artist: ...
    def add_patch(self, patch: Polygon) -> Polygon: ...
    def plot(
        self, x: Sequence[float], y: Sequence[float], **kwargs: StyleValue
    ) -> list[Artist]: ...
    def scatter(self, x: Sequence[float], y: Sequence[float], **kwargs: StyleValue) -> Artist: ...
    def annotate(self, text: str, xy: tuple[float, float], **kwargs: StyleValue) -> Artist: ...
    def get_legend_handles_labels(self) -> tuple[list[Artist], list[str]]: ...
    def legend(
        self, handles: Iterable[Artist], labels: Iterable[str], **kwargs: StyleValue
    ) -> Artist: ...
