# Narrow public SymPy API types used by the bounded math worker.
# SymPy 1.14 ships no stubs; these declarations follow its public constructors.

from collections.abc import Iterator
from typing import override

class Basic:
    @property
    def args(self) -> tuple[Basic, ...]: ...

class Expr(Basic):
    is_real: bool | None
    is_finite: bool | None
    is_zero: bool | None
    is_number: bool
    @property
    def free_symbols(self) -> set[Symbol]: ...
    def subs(self, old: Symbol, new: Expr) -> Expr: ...
    def doit(self) -> Expr: ...
    def evalf(self, n: int = ...) -> Expr: ...
    def has(self, *patterns: type[Basic] | Basic) -> bool: ...
    def __float__(self) -> float: ...
    def __sub__(self, other: Expr) -> Expr: ...
    def __neg__(self) -> Expr: ...

class Symbol(Expr):
    name: str
    def __init__(self, name: str, *, real: bool = ...) -> None: ...

class Rational(Expr):
    def __init__(self, numerator: str | float, denominator: int | None = ...) -> None: ...

class Add(Expr):
    def __init__(self, *args: Expr | int, evaluate: bool = ...) -> None: ...

class Mul(Expr):
    def __init__(self, *args: Expr | int, evaluate: bool = ...) -> None: ...

class Pow(Expr):
    def __init__(self, base: Expr | int, exponent: Expr | int, *, evaluate: bool = ...) -> None: ...

class Abs(Expr):
    def __init__(self, argument: Expr, *, evaluate: bool = ...) -> None: ...

class Integral(Expr): ...

class Set(Basic):
    def intersect(self, other: Set) -> Set: ...

class Interval(Set):
    start: Expr
    end: Expr
    left_open: bool
    right_open: bool
    def __init__(self, start: float | Expr, end: float | Expr) -> None: ...

class Union(Set):
    @property
    @override
    def args(self) -> tuple[Set, ...]: ...

class _Singletons:
    Reals: Set
    EmptySet: Set

S: _Singletons
pi: Expr
E: Expr
oo: Expr
zoo: Expr
nan: Expr

def sin(argument: Expr, *, evaluate: bool = ...) -> Expr: ...
def cos(argument: Expr, *, evaluate: bool = ...) -> Expr: ...
def tan(argument: Expr, *, evaluate: bool = ...) -> Expr: ...
def exp(argument: Expr, *, evaluate: bool = ...) -> Expr: ...
def log(argument: Expr, *, evaluate: bool = ...) -> Expr: ...
def simplify(expression: Expr) -> Expr: ...
def diff(expression: Expr, symbol: Symbol) -> Expr: ...
def integrate(expression: Expr, variable: Symbol | tuple[Symbol, Expr, Expr]) -> Expr: ...
def latex(expression: Expr) -> str: ...
def preorder_traversal(expression: Expr) -> Iterator[Basic]: ...
